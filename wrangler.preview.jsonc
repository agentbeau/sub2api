{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sub2api",
  "main": "src/preview.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Cpa"] }],
  "previews": {
    "vars": {
      "CONTAINER_IDLE_TIMEOUT_MS": "1000",
      "DASHBOARD_AUTH": "cloudflare",
      "ACCESS_AUD": "REQUIRES_PREVIEW_OWNER_ACCESS_AUDIENCE",
      "PREVIEW_ACCESS_AUD": "REQUIRES_PREVIEW_OWNER_ACCESS_AUDIENCE"
    },
    "containers": [{
      "class_name": "Cpa",
      "image": "./container/Dockerfile",
      "image_build_context": "./container",
      "instance_type": "basic",
      "max_instances": 1
    }],
    "durable_objects": { "bindings": [{ "name": "CPA", "class_name": "Cpa" }] },
    "r2_buckets": [{ "binding": "STATE", "bucket_name": "sub2api-preview-isolated" }],
    "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1101", "simple": { "limit": 5, "period": 60 } }]
  }
}
