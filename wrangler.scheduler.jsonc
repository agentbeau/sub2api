{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gateway-scheduler-lab",
  "main": "src/scheduler-preview.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ScheduledEngine"
      ]
    }
  ],
  "vars": {
    "CONTAINER_IDLE_TIMEOUT_MS": "1000",
    "DASHBOARD_AUTH": "cloudflare",
    "ACCESS_AUD": "REQUIRES_SEPARATE_SCHEDULER_ACCESS",
    "PREVIEW_ACCESS_AUD": "REQUIRES_SEPARATE_SCHEDULER_ACCESS"
  },
  "containers": [
    {
      "name": "gateway-scheduler-lab-engine",
      "class_name": "ScheduledEngine",
      "scheduling_policy": "durable_object",
      "images": {
        "engine": {
          "image": "registry.cloudflare.com/c05a228a4bebdc8625e8f42d405475a7/gateway-engine@sha256:6a8959018529d6d505278eae7e346d550fbd511da3ba069d7be11871a05a47f1"
        }
      },
      "observability": {
        "logs": {
          "enabled": true
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ENGINE",
        "class_name": "ScheduledEngine"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "STATE",
      "bucket_name": "gateway-scheduler-lab-state"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMIT",
      "namespace_id": "1102",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
