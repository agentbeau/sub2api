{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sub2api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [{ "pattern": "api.agentbeau.dev", "custom_domain": true }],
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.01 } },
  "build": { "command": "npm run build" },
  "vars": {
    "CONTAINER_IDLE_TIMEOUT_MS": "1000",
    "DASHBOARD_AUTH": "cloudflare",
    "ACCESS_AUD": "a6acab2578806d53309922d135ad923c92c9071cbe22f34677ed763c09951170"
  },
  "containers": [
    {
      "name": "sub2api",
      "class_name": "Cpa",
      "image": "./container/Dockerfile",
      "image_build_context": "./container",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CPA", "class_name": "Cpa" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Cpa"] }],
  "r2_buckets": [{ "binding": "STATE", "bucket_name": "sub2api" }],
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
